{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlightSchoolScheduler",
  "version": "0.1.0",
  "identifier": "com.flightschool.scheduler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "לוח טיסות — בית ספר למפעילי כטמ״מ",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
